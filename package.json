{
  "name": "stillup",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Rodrigo Espinosa Curbelo",
  "homepage": "https://rec.farm/stillup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rec-farm/stillup.git"
  },
  "bugs": "https://github.com/rec-farm/stillup/issues",
  "type": "module",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @stillup/web dev",
    "build": "pnpm --filter @stillup/web build && cargo build --manifest-path backend/Cargo.toml --release --locked --bins",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run packages/core packages/sdk apps/web/lib tests/legacy-api/src/oidc-state.test.ts",
    "db:migrate": "cargo run --manifest-path backend/Cargo.toml --bin stillup-api -- migrate",
    "check": "pnpm typecheck && pnpm test && pnpm test:rust && pnpm build",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/legacy-api/src/integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stillup": "tsx apps/cli/src/main.ts",
    "test:rust": "cargo test --manifest-path backend/Cargo.toml",
    "test:rust:integration": "cargo test --manifest-path backend/Cargo.toml --test runtime -- --ignored",
    "dev:api": "cargo run --manifest-path backend/Cargo.toml --bin stillup-api",
    "dev:worker": "cargo run --manifest-path backend/Cargo.toml --bin stillup-api -- worker"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
