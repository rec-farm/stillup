{
  "name": "stillup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run packages/core",
    "db:migrate": "pnpm --filter @stillup/api db:migrate",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run apps/api/src/integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stillup": "tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "tsx": "^4.20.0",
    "vitest": "^4.1.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.0"
  }
}
