DATABASE_URL=postgres://stillup:stillup@localhost:5437/stillup
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
APP_ORIGIN=http://stillup.localhost:1355
HOST=127.0.0.1
PORT=3001
API_URL=http://127.0.0.1:3001
ALLOW_PRIVATE_NETWORKS=false
STATUS_PAGE_TITLE=Service status
# Rust API/static server: comma-separated public-only hostnames, without scheme or port.
# Configure DNS and HTTPS at your ingress/CDN; preserve the original Host header.
STATUS_PAGE_DOMAINS=
# Host port for the API/static server in `docker compose --profile app` (bound to 127.0.0.1).
STILLUP_WEB_PORT=3000
ALERT_WEBHOOK_URL=
RUN_RETENTION_DAYS=30

# Optional "Sign in with Handstamp" (any OpenID Connect provider). Off while OIDC_ISSUER or
# OIDC_CLIENT_ID is empty. Register the redirect URI $APP_ORIGIN/api/v1/auth/oidc/callback and
# the post-logout URI $APP_ORIGIN/login. Everyone the provider lets in becomes the administrator,
# so restrict who may sign in at the provider (e.g. Handstamp's required group stillup-admins).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
OIDC_DISPLAY_NAME=Handstamp

# Trusted GitHub Actions workflows deploy monitoring as code without a stored secret (API access
# on the dashboard). Only for GitHub Enterprise Server: https://HOST/_services/token
# GITHUB_ACTIONS_ISSUER=https://token.actions.githubusercontent.com

# Agents (Claude Code, Codex, Cursor…) act for StillUp users through farmhand, the rec.farm MCP
# gateway: its public origin. Needs OIDC_ISSUER; farmhand must use the same provider.
# GATEWAY_ISSUER=https://farmhand.example.com
# Reference in a header/body as {{API_TOKEN}}:
# CHECK_SECRET_API_TOKEN=your-token

# Generate once with openssl rand -hex 32. Keep outside the database and back it up securely.
# Must be identical on the API and workers. Never replace it while encrypted secrets exist.
SECRETS_ENCRYPTION_KEY=
