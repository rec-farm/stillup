# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
APP_ORIGIN=http://stillup.localhost:1355
HOST=127.0.0.1
PORT=3001
API_URL=http://127.0.0.1:3001
ALLOW_PRIVATE_NETWORKS=false
STATUS_PAGE_TITLE=Service status
# Web server: comma-separated public-only hostnames, without scheme or port.
# Configure DNS and HTTPS at your ingress/CDN; preserve the original Host header.
STATUS_PAGE_DOMAINS=
ALERT_WEBHOOK_URL=
RUN_RETENTION_DAYS=30
# Reference in a header/body as {{API_TOKEN}}:
# CHECK_SECRET_API_TOKEN=your-token

# Generate once with openssl rand -hex 32. Keep outside the database and back it up securely.
# Must be identical on the API and workers. Never replace it while encrypted secrets exist.
SECRETS_ENCRYPTION_KEY=
