{
  "name": "@rec/stillup",
  "version": "0.2.0",
  "description": "StillUp monitoring as code: validate, test, preview, and deploy HTTP checks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "stillup": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/packages/sdk/src/index.d.ts",
      "import": "./dist/packages/sdk/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rec-farm/stillup.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "pnpm --dir ../.. check && npm run test:package",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stillup/sdk": "workspace:*"
  },
  "author": "Rodrigo Espinosa Curbelo",
  "homepage": "https://rec.farm/stillup/",
  "bugs": "https://github.com/rec-farm/stillup/issues"
}
